{
  "manifest_version": 3,
  "name": "bs sync",
  "version": "0.1.1",
  "description": "Sync bookmarks and passwords through a bs server",
  "permissions": ["bookmarks", "storage", "alarms", "unlimitedStorage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["totp.js", "content.js", "save.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "bs sync"
  },
  "options_page": "options.html",
  "minimum_chrome_version": "116"
}
